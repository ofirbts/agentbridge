{
  "name": "agentbridge",
  "version": "0.1.0",
  "language": "go",
  "module": "github.com/ofirbts/agentbridge",
  "workflow": {
    "small_task": ["developer", "strict-reviewer"],
    "large_task": ["architect", "developer", "strict-reviewer"],
    "on_failure": ["debugger"]
  },
  "agents": {
    "developer": ".cursor/agents/developer.md",
    "strict-reviewer": ".cursor/agents/strict-reviewer.md",
    "architect": ".cursor/agents/architect.md",
    "debugger": ".cursor/agents/debugger.md"
  },
  "skills": {
    "feature-build": ".cursor/skills/feature-build/SKILL.md",
    "supabase-dev": ".cursor/skills/supabase-dev/SKILL.md",
    "review-gate": ".cursor/skills/review-gate/SKILL.md"
  },
  "commands": {
    "build": "make build",
    "test": "make test",
    "e2e": "make e2e",
    "dev": "make dev",
    "benchmark": "make benchmark",
    "race": "make race"
  },
  "pr3_scope": [
    "pkg/mcp/http.go",
    "pkg/mcp/factory.go",
    "cmd mcp-transport flag",
    "module github.com/ofirbts/agentbridge"
  ],
  "pr2_scope": [
    "cmd run/explain/inspect/simulate-failure enhancements",
    "internal/crawl/http.go",
    "pkg/mcp stub client",
    "examples/*.sh",
    "docs/INFRA-NOTES.md",
    "docs/DECISION.md"
  ],
  "out_of_scope": [
    "web UI",
    "full scraper engine",
    "browser automation"
  ]
}
